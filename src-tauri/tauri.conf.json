{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "땡해줘",
  "mainBinaryName": "ttaeng",
  "version": "0.3.4",
  "identifier": "com.lsft32.ttaeng",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "땡해줘",
        "width": 360,
        "height": 440,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "shadow": true
      },
      {
        "label": "details",
        "url": "details.html",
        "title": "땡해줘",
        "width": 860,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "부팅 후 언제부터 PC를 써도 되는지 보여줍니다",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "language": "ko-KR"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzMzZDOUI2OTk4RkRCMjUKUldRbDI0K1p0c2sydzRycVlTN3pabGEvT2hLUGVlKzFMM3I3VDJnUUw4eENtU2FzOC9rWTVoSlkK",
      "endpoints": [
        "https://github.com/lsft32/ttaeng/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
